{
    "name": "yiisoft/yii2-app-basic",
    "description": "Yii 2 Basic Project Template",
    "keywords": ["yii2", "framework", "basic", "project template"],
    "homepage": "https://www.yiiframework.com/",
    "type": "project",
    "license": "BSD-3-Clause",
    "support": {
        "issues": "https://github.com/yiisoft/yii2/issues?state=open",
        "forum": "https://www.yiiframework.com/forum/",
        "wiki": "https://www.yiiframework.com/wiki/",
        "irc": "irc://irc.freenode.net/yii",
        "source": "https://github.com/yiisoft/yii2"
    },
    "minimum-stability": "stable",
    "require": {
        "php": ">=7.4.0",
        "yiisoft/yii2": "~2.0.45",
        "yiisoft/yii2-bootstrap5": "2.0.3",
        "kartik-v/yii2-bootstrap5-dropdown": "@dev",
        "yiisoft/yii2-symfonymailer": "~2.0.3",
        "kartik-v/yii2-widget-select2": "@dev",
        "phpoffice/phpspreadsheet": "^1.28",
        "yiisoft/yii2-swiftmailer": "^2.0",
        "webvimark/module-user-management": "^1.0",
        "demogorgorn/yii2-ajax-submit-button": "^1.2",
        "kartik-v/yii2-widget-depdrop": "@dev",
        "kartik-v/yii2-dynagrid": "@dev",
        "kartik-v/yii2-mpdf": "dev-master",
        "ruskid/yii2-csv-importer": "dev-master",
        "perminder-klair/yii2-dropzone": "dev-master",
        "kartik-v/yii2-detail-view": "@dev",
        "wbraganca/yii2-dynamicform": "*",
        "kartik-v/yii2-widgets": "*",
        "kartik-v/yii2-date-range": "dev-master",
        "kartik-v/yii2-field-range": "*",
        "guzzlehttp/guzzle": "^7.5",
        "phpseclib/phpseclib": "^3.0",
        "nickcv/yii2-encrypter": "^1.1",
        "jaspersoft/rest-client": "dev-master",
        "softark/yii2-dual-listbox": "dev-master",
        "linslin/yii2-curl": "*",
        "kartik-v/yii2-tabs-x": "^1.2",
        "yiisoft/yii2-queue": "^2.3",
        "tecnickcom/tcpdf": "^6.6",
        "yiisoft/yii2-imagine": "^2.3",
        "nullref/yii2-datatables": "^1.1",
        "yiisoft/yii2-redis": "^2.0",
        "kartik-v/yii2-export": "@dev",
        "kartik-v/yii2-editable": "^1.8",
        "spanjeta/yii2-backup": "*",
        "2amigos/yii2-multi-select-widget": "*",
        "php-amqplib/php-amqplib": "^2.10",
        "creocoder/yii2-flysystem": "^1.2",
        "league/flysystem-aws-s3-v3": "^1.0"
    },
    "require-dev": {
        "yiisoft/yii2-debug": "~2.1.0",
        "yiisoft/yii2-gii": "~2.2.0",
        "yiisoft/yii2-faker": "~2.0.0",
        "phpunit/phpunit": "~9.5.0",
        "codeception/codeception": "^5.0.0 || ^4.0",
        "codeception/lib-innerbrowser": "^4.0 || ^3.0 || ^1.1",
        "codeception/module-asserts": "^3.0 || ^1.1",
        "codeception/module-yii2": "^1.1",
        "codeception/module-filesystem": "^3.0 || ^2.0 || ^1.1",
        "codeception/verify": "^3.0 || ^2.2",
        "symfony/browser-kit": "^6.0 || >=2.7 <=4.2.4"
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer" : true
        },
        "process-timeout": 1800,
        "fxp-asset": {
            "enabled": false
        },
        "platform": {
            "php": "7.4"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "yii\\composer\\Installer::postInstall"
        ],
        "post-create-project-cmd": [
            "yii\\composer\\Installer::postCreateProject",
            "yii\\composer\\Installer::postInstall"
        ]
    },
    "extra": {
        "yii\\composer\\Installer::postCreateProject": {
            "setPermission": [
                {
                    "runtime": "0777",
                    "web/assets": "0777",
                    "yii": "0755"
                }
            ]
        },
        "yii\\composer\\Installer::postInstall": {
            "generateCookieValidationKey": [
                "config/web.php"
            ]
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ]
}
